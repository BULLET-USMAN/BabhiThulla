# ============================================================
# Bhabhi Thulla Monorepo Environment Variables
# ============================================================

# -----------------
# Server Configuration (apps/server)
# -----------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Managed PostgreSQL (Neon, Render, Supabase, RDS)
# Omit in local dev to automatically use hermetic pg-mem engine
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Security & Secrets (Must be overridden in production)
# Generate 32-byte hex keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bhabhi-thulla-insecure-secret-change-in-prod
GAME_STATE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Operational Timers
LOG_LEVEL=info
RECONNECT_GRACE_PERIOD_MS=120000
RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX=10

# -----------------
# Web Frontend Configuration (apps/web)
# -----------------
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_SERVER_URL=http://localhost:3001
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_APP_TITLE="Bhabhi Thulla"
