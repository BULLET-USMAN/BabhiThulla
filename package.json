{
  "name": "bhabhi-thulla-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-quality online multiplayer Bhabhi Thulla card game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bhabhi/web",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"SERVER,WEB\" -c \"blue,green\" \"npm run dev --workspace=@bhabhi/server\" \"npm run dev --workspace=@bhabhi/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "android:sync": "npm run build --workspace=@bhabhi/web && npm run cap:sync --workspace=@bhabhi/web",
    "android:open": "npm run cap:open --workspace=@bhabhi/web",
    "android:build": "npm run cap:build --workspace=@bhabhi/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
