# ==========================================
# Bhabhi Thulla Web Frontend Environment Variables
# ==========================================

# Backend REST API Endpoint (e.g. Render Web Service URL)
VITE_API_URL=http://localhost:3001

# Backend Real-time WebSocket Endpoint (Socket.IO)
VITE_SOCKET_URL=http://localhost:3001

# Legacy fallback for backward compatibility
VITE_SERVER_URL=http://localhost:3001

# Public Application Canonical URL (Used for generating room invitation links)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Application Branding
VITE_APP_TITLE="Bhabhi Thulla"
