# ==========================================
# Bhabhi Thulla Server Environment Variables
# ==========================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Allowed Client Origins (Comma-separated for multiple origins, e.g. Vercel deployment & custom domain)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Example: postgresql://postgres:password@localhost:5432/bhabhi_thulla
# If omitted in development or test, the server falls back to hermetic in-memory pg-mem.
# In production, a valid managed PostgreSQL connection string is required.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Session Authentication & Token Verification (HMAC-SHA256)
# MUST be set to a secure, randomly generated secret in production!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bhabhi-thulla-insecure-secret-change-in-prod

# Game State Snapshot Encryption (AES-256-GCM)
# 64-character hexadecimal key (256-bit). Must remain consistent across server restarts!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_STATE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging & Operational Parameters
LOG_LEVEL=info
RECONNECT_GRACE_PERIOD_MS=120000
RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX=10
ROOM_IDLE_TIMEOUT_MS=3600000
